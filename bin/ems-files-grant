#!ts
/**
 * ems-files-grant — names for paths through the `ems-files` service, for a while, as a request's
 * files get them, to try a media service's way to EiN's files by hand: from another host, or with
 * sshfs or sftp in place of EMS.
 *
 * Each `--read` (a file to read) and `--write` (a file to write) is a VFS path, or a path on disk.
 * Prints the `EMS-Files` header that reaches them, then each name and the path it stands for. The
 * names end after `--seconds`, as a request's end with its answer.
 */

import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import { canonical, filesState, grant, headerValue } from '@ems/files';
import { emsUrl } from '@ems/client';

const DEFAULT_SECONDS = 300;

const emsFilesGrant = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, {
    string: ['read', 'write', 'seconds'],
    collect: ['read', 'write'],
    unknown: collectUnknownFlags(unknown),
  });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const endpoint = filesState().endpoints.get(emsUrl(cmd));
  if (!endpoint) {
    await cmd.writeError('ems-files-grant: ems-files serves nothing (CFG_EMS_FILES_ADDRESS is empty, or the service is not running)\n');
    return 1;
  }
  const seconds = Number(flags.seconds ?? DEFAULT_SECONDS);
  if (!Number.isFinite(seconds) || seconds <= 0) {
    await cmd.writeError(`ems-files-grant: --seconds: not a number of seconds: ${flags.seconds}\n`);
    return 1;
  }
  const paths: { path: string; mode: 'read' | 'write' }[] = [];
  for (const mode of ['read', 'write'] as const) {
    for (const value of (flags[mode] as string[] | undefined) ?? []) {
      const path = canonical(value);
      if (!path) {
        await cmd.writeError(`ems-files-grant: --${mode}: not an absolute path: ${value}\n`);
        return 1;
      }
      paths.push({ path, mode });
    }
  }
  if (paths.length === 0) {
    await cmd.writeError('ems-files-grant: nothing to grant: give --read or --write\n');
    return 1;
  }
  const { names, release } = await grant(cmd, paths);
  setTimeout(release, seconds * 1000);
  await cmd.writeLn(headerValue(endpoint));
  for (const [index, name] of names.entries()) await cmd.writeLn(`${paths[index].mode} ${name} ${paths[index].path}`);
  return 0;
};

emsFilesGrant.spec = {
  name: 'ems-files-grant',
  admin: true,
  effect: 'write' as const,
  json: false,
  description: "Names for paths through ems-files for a while, and the EMS-Files header that reaches them, to try a media service's way to EiN's files by hand",
  args: [],
  flags: [
    { name: 'read', type: 'string' as const, description: 'A file to read, as a VFS path or a path on disk; may be given more than once' },
    { name: 'write', type: 'string' as const, description: 'A file to write; may be given more than once' },
    { name: 'seconds', type: 'string' as const, description: `How long the names last (default ${DEFAULT_SECONDS})` },
  ],
  examples: ['ems-files-grant --read /archive/albums/Exempelalbum_2019/IMG_0001.JPG --seconds 120'],
  returns: 'the EMS-Files header value, then a line per path: read or write, its name, the path.',
};

export default emsFilesGrant;
