#!ts
/**
 * ems-gpu — the card of an instance of the media service now, the primary's or the one `--instance`
 * names, with its last six hours.
 *
 * Read back from the readings of the instance's machine device (`/dev/ems`, `/dev/ems-<name>`)
 * that the `ems-sampler` service keeps, so a dashboard open in three browsers costs no request to
 * EMS. Null when there is no reading in those six hours: no media service, or one that sees no
 * card — no GPU and an idle GPU are not the same fact.
 *
 * `--gauge` answers the gauges `top` draws beside the host's RAM (the `ems-sampler` service's
 * `gaugeCommand`): each card's utilization and its memory, another instance's named after it, and
 * none for an instance without a reading.
 */
import { type CmdReturn, collectUnknownFlags, type Command, type Gauge, parseArgs, reportUnknownFlags } from '@ein/client';
import type { EmsGpu } from '@ems/api';
import { otherInstanceNames, PRIMARY } from '@ems/instances';
import { readMachine } from '@ems/machine';

const WINDOW_MS = 6 * 60 * 60 * 1000;

/** An instance's card now and its last six hours, from its machine's readings; null without a reading. */
const cardOf = async (cmd: Command, name: string): Promise<EmsGpu> => {
  const read = (endpoint: string) => readMachine(cmd, name, endpoint, WINDOW_MS);
  const [util, vram, total, temp, decoder, encoder, power, powerLimit] = await Promise.all(
    ['gpu', 'vram-used', 'vram-total', 'gpu-temperature', 'decoder', 'encoder', 'gpu-power', 'gpu-power-limit'].map(read),
  );
  if (util.now === undefined || vram.now === undefined || total.now === undefined || temp.now === undefined) return null;
  const memTotalMb = Math.round(total.now * 1024);
  return {
    utilPct: util.now,
    ...(decoder.now !== undefined ? { decPct: decoder.now } : {}),
    ...(encoder.now !== undefined ? { encPct: encoder.now } : {}),
    memUsedMb: Math.round(memTotalMb * vram.now / 100),
    memTotalMb,
    tempC: temp.now,
    ...(power.now !== undefined ? { powerW: power.now } : {}),
    ...(powerLimit.now !== undefined ? { powerLimitW: powerLimit.now } : {}),
    vramPercent: vram.now,
    utilSeries: util.series,
    vramSeries: vram.series,
  };
};

const emsGpu = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { boolean: ['gauge'], string: ['instance'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;

  if (flags.gauge) {
    const names = flags.instance ? [String(flags.instance)] : [PRIMARY, ...await otherInstanceNames(cmd)];
    const gauges: Gauge[] = [];
    for (const name of names) {
      const card = await cardOf(cmd, name);
      if (!card) continue;
      const of = name === PRIMARY ? '' : ` ${name}`;
      gauges.push(
        { label: `GPU${of}`, percent: card.utilPct, value: `${Math.round(card.utilPct)}%  ${card.tempC}°C` },
        { label: `VRAM${of}`, percent: card.vramPercent, value: `${(card.memUsedMb / 1024).toFixed(1)}/${(card.memTotalMb / 1024).toFixed(1)} GB` },
      );
    }
    if (cmd.json) await cmd.writeJSON(gauges);
    else for (const gauge of gauges) await cmd.writeLn(`${gauge.label} ${gauge.value}`);
    return 0;
  }

  const answer = await cardOf(cmd, String(flags.instance || PRIMARY));

  if (cmd.json) {
    await cmd.writeJSON(answer satisfies EmsGpu);
    return 0;
  }
  if (!answer) await cmd.writeLn('no GPU reading in the last six hours');
  else await cmd.writeLn(`gpu ${Math.round(answer.utilPct)}%  vram ${answer.memUsedMb}/${answer.memTotalMb} MB  ${answer.tempC}°C`);
  return 0;
};

emsGpu.spec = {
  name: 'ems-gpu',
  effect: 'read' as const,
  description: 'The GPU of an instance of the media service now, with the last six hours of utilization and VRAM, from its machine device',
  args: [],
  flags: [
    {
      name: 'gauge',
      type: 'bool' as const,
      description: "The GPU and VRAM gauges top draws beside the host, each instance's with a card (the ems-sampler service declares it)",
    },
    { name: 'instance', type: 'string' as const, description: 'The instance whose card (ems-instance list); main, the primary, by default' },
  ],
  examples: ['ems-gpu', 'ems-gpu --instance laptop', 'ems-gpu --gauge'],
  returns: 'utilPct, memUsedMb, memTotalMb, tempC, vramPercent and the utilization and VRAM series, or null when there is no reading.',
};

export default emsGpu;
