#!ts
/**
 * ems-gpu-sample — one reading of the card an instance of the media service runs on, the primary
 * or the one `--instance` names, which the `gpu-sampler` service appends to its `gpu` metrics series.
 *
 * The card is EMS's: this container is given none, and never looks for one. EMS's own health
 * answer says what its `nvidia-smi` sees, whole-card, and that is what the dashboard charts.
 * `null` when there is no media service configured, it is not answering, or it sees no card —
 * the service then writes nothing, rather than a row of zeroes that reads as an idle GPU.
 */

import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import { sampleGpu } from '@ems/gpu';
import { PRIMARY, readInstance } from '@ems/instances';

const emsGpuSample = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { string: ['instance'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const instance = await readInstance(cmd, String(flags.instance || PRIMARY));
  const sample = instance ? await sampleGpu(instance) : undefined;
  if (cmd.json) await cmd.writeJSON(sample ?? null);
  else await cmd.writeLn(sample ? `${sample.utilPct}% · ${sample.memUsedMb}/${sample.memTotalMb} MB · ${sample.tempC} °C` : 'no GPU reading');
  return 0;
};

emsGpuSample.spec = {
  name: 'ems-gpu-sample',
  effect: 'read' as const,
  description: "One reading of the media service's GPU: utilization, VRAM and temperature",
  args: [],
  flags: [{ name: 'instance', type: 'string' as const, description: 'The instance to ask (ems-instance list); main, the primary, by default' }],
  examples: ['ems-gpu-sample', 'ems-gpu-sample --instance laptop'],
  returns: 'utilPct, memUsedMb, memTotalMb and tempC, or null when there is no reading.',
};

export default emsGpuSample;
