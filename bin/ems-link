#!ts
/**
 * ems-link — watches every instance of the media service, as the `ems-link` service.
 *
 * EMS is not an EiN service — each instance is a container of its own — but the dashboard reads
 * service rows, and the crawl is blind without one: a backlog that stops draining looks exactly
 * like a slow crawl until someone asks. This is that row. It logs every change of an instance's
 * reachability, so "the laptop went away at 03:12" is in a service log rather than reconstructed
 * from failed steps.
 *
 * A new EMS build is the likeliest fix for whatever failed under the last one, so when an instance's
 * build changes, every failed pipeline instance gets one run at once (`pipeline heal --now`)
 * instead of waiting out its heal. Not on the first build seen of an instance: a restart of EiN is
 * not a new EMS. The workers for an instance stop and start of themselves (`media-pool-kinds
 * --expect`), so nothing here starts or stops them.
 */

import { type CmdReturn, type Command, shq } from '@ein/client';
import { capabilitiesOf } from '@ems/client';
import { listInstances } from '@ems/instances';

const DEFAULT_INTERVAL_SECONDS = 60;

/** How long each instance's capabilities may take before it counts as down this round. */
const WAIT_SECONDS = 10;

/** One instance's one-line state, as `ems-status --brief` prints it. */
const brief = async (cmd: Command, name: string): Promise<string> => {
  const { stdout } = await cmd.execute(`JSON_OUTPUT=0 ems-status --instance ${shq(name)} --brief`).catch(() => ({ stdout: '' }));
  return stdout.trim() || 'answering';
};

const emsLink = async (cmd: Command): CmdReturn => {
  const stopped = new Promise<void>((resolve) => cmd.onInterrupt(resolve));
  const seconds = Number(cmd.env.CFG_EMS_LINK_INTERVAL_SECONDS) || DEFAULT_INTERVAL_SECONDS;
  const reachable = new Map<string, boolean>();
  const builds = new Map<string, string>();
  let ending = false;
  stopped.then(() => ending = true);

  await cmd.writeLn(`ems-link: watching the media service's instances every ${seconds}s`);
  while (!ending) {
    const instances = await listInstances(cmd).catch(() => []);
    const answers = await Promise.all(instances.map((instance) => capabilitiesOf(cmd, instance, WAIT_SECONDS)));
    let newBuild: string | undefined;
    for (const [i, instance] of instances.entries()) {
      const up = answers[i] !== null;
      if (reachable.get(instance.name) !== up) {
        await cmd.writeLn(`ems-link: ${instance.name} ${up ? `up — ${await brief(cmd, instance.name)}` : `down — ${instance.url} not answering`}`);
        reachable.set(instance.name, up);
      }
      const commit = answers[i]?.build?.commit;
      if (!commit) continue;
      const before = builds.get(instance.name);
      if (before && before !== commit) newBuild = `${instance.name} ${before} -> ${commit}`;
      builds.set(instance.name, commit);
    }
    for (const name of [...reachable.keys()].filter((name) => !instances.some((instance) => instance.name === name))) {
      await cmd.writeLn(`ems-link: ${name} removed`);
      reachable.delete(name);
      builds.delete(name);
    }
    if (newBuild) {
      const { stdout } = await cmd.execute('pipeline heal --now --apply').catch((error) => ({ stdout: String(error) }));
      await cmd.writeLn(`ems-link: EMS ${newBuild}; failed work runs again: ${stdout.trim()}`);
    }
    let timer: ReturnType<typeof setTimeout> | undefined;
    await Promise.race([stopped, new Promise((resolve) => timer = setTimeout(resolve, seconds * 1000))]);
    clearTimeout(timer);
  }
  return 0;
};

emsLink.spec = {
  name: 'ems-link',
  admin: true,
  daemon: true,
  effect: 'write' as const,
  json: false,
  description: "Watch every instance of the media service: log when one comes or goes, and run failed work again when one's build changes (the ems-link service)",
  args: [],
  flags: [],
};

export default emsLink;
