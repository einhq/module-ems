#!ts
/**
 * ems-memory — the memory of the machine the media service runs on, now and over the last six
 * hours, for the Overview's EMS RAM tile: in use against the total, and what EMS's own container
 * holds of it. That machine need not be EiN's.
 *
 * The machine's are its device's readings (`/dev/ems`: `memory-used`, `memory-total`), EMS's own
 * the newest `ems-models` sample's; the `ems-sampler` service keeps both, so the tile costs no
 * request to EMS. Null when there is no reading of the machine in those six hours.
 */

import type { CmdReturn, Command } from '@ein/client';
import { readTail, seriesPath } from '@ein/client';
import type { EmsMemory, EmsModelsSample } from '@ems/api';
import { PRIMARY } from '@ems/instances';
import { readMachine } from '@ems/machine';

const WINDOW_MS = 6 * 60 * 60 * 1000;

const emsMemory = async (cmd: Command): CmdReturn => {
  const [used, total, [models]] = await Promise.all([
    readMachine(cmd, PRIMARY, 'memory-used', WINDOW_MS),
    readMachine(cmd, PRIMARY, 'memory-total', WINDOW_MS),
    readTail<EmsModelsSample>(cmd.sys.vfs, cmd.access, seriesPath('ems-models'), 1).catch(() => []),
  ]);
  // The total is in GB of 1024³ bytes, as the device keeps it.
  const totalMb = total.now !== undefined ? Math.round(total.now * 1024) : undefined;
  const own = models?.value.memory;

  const answer: EmsMemory = used.now !== undefined && totalMb !== undefined
    ? {
      usedMb: Math.round(totalMb * used.now / 100),
      totalMb,
      percent: used.now,
      ...(own?.usedMb !== undefined ? { emsMb: own.usedMb } : {}),
      ...(own?.limitMb !== undefined ? { emsLimitMb: own.limitMb } : {}),
      series: used.series,
    }
    : null;

  if (cmd.json) {
    await cmd.writeJSON(answer satisfies EmsMemory);
    return 0;
  }
  if (!answer) await cmd.writeLn("no reading of the media service machine's memory in the last six hours");
  else await cmd.writeLn(`ram ${Math.round(answer.percent)}%  ${answer.usedMb}/${answer.totalMb} MB${answer.emsMb !== undefined ? `  ems ${answer.emsMb} MB` : ''}`);
  return 0;
};

emsMemory.spec = {
  name: 'ems-memory',
  effect: 'read' as const,
  description: "The memory of the media service's machine now, with the last six hours, and what EMS holds of it",
  args: [],
  flags: [],
  examples: ['ems-memory'],
  returns: 'usedMb, totalMb, percent, emsMb, emsLimitMb and the series of percent, or null when there is no reading.',
};

export default emsMemory;
