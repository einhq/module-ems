# ems's own choice of settings, linked as /etc/config.d/ems by mod setup and sourced before
# /etc/config, so a value the administrator sets there wins over these.

# Turn texts into vectors with EMS's text model, for whatever finds things by meaning.
export CFG_TEXT_EMBEDDER='ems-text-embed'
# Render a page as live video for a screen near the browser, which "Show on" hands its address to.
# Five minutes without a reader leave time to pick the screen, and to leave the page a while on a
# phone, whose Chrome pauses the screen meanwhile; a new start replaces one of the caller's nobody reads.
export CFG_PAGE_STREAMER='page-stream start --idle=300'
# Control such a page, which a screen's controls do: press keys in it (a slideshow's previous, pause
# and next), ask what it shows, and hand it messages (move its video).
export CFG_PAGE_CONTROL='page-stream'
